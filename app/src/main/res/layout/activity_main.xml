<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frekvencia Generátor"
            android:textColor="@color/gold"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Kijelző -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/screen_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="7.83"
                    android:textColor="@color/trace"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Hz"
                    android:textColor="@color/muted"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/trace"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <hu.galvill.frekvencia.ScopeView
                android:id="@+id/scope"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Indítás -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:background="@drawable/btn_gold"
                android:minWidth="180dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="▶  INDÍTÁS"
                android:textColor="#1E1E1E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="monospace"
                android:textColor="@color/muted"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Mód -->
        <TextView
            style="@style/Label"
            android:text="LEJÁTSZÁSI MÓD" />

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbBin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/gold"
                android:text="Binaurális"
                android:textColor="@color/fg" />

            <RadioButton
                android:id="@+id/rbIso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/gold"
                android:text="Izokronikus"
                android:textColor="@color/fg" />

            <RadioButton
                android:id="@+id/rbPure"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/gold"
                android:text="Tiszta hang"
                android:textColor="@color/fg" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <!-- Hangerő -->
        <TextView
            android:id="@+id/tvVol"
            style="@style/Label"
            android:text="HANGERŐ  30%" />

        <SeekBar
            android:id="@+id/sbVol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="30"
            android:progressTint="@color/gold"
            android:thumbTint="@color/gold" />

        <!-- Vivőhang -->
        <TextView
            android:id="@+id/tvCar"
            style="@style/Label"
            android:text="VIVŐHANG  200 Hz" />

        <SeekBar
            android:id="@+id/sbCar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="500"
            android:min="100"
            android:progress="200"
            android:progressTint="@color/gold"
            android:thumbTint="@color/gold" />

        <!-- Időzítő -->
        <TextView
            style="@style/Label"
            android:text="IDŐZÍTŐ" />

        <Spinner
            android:id="@+id/spTimer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp" />

        <!-- Egyéni -->
        <TextView
            style="@style/Label"
            android:text="EGYÉNI FREKVENCIA (Hz)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etCustom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:hint="pl. 10 vagy 7.83"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:textColor="@color/fg"
                android:textColorHint="@color/muted" />

            <Button
                android:id="@+id/btnCustom"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/btn_outline"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Beállít"
                android:textAllCaps="false"
                android:textColor="@color/gold" />
        </LinearLayout>

        <!-- Előbeállítások (kódból töltve) -->
        <LinearLayout
            android:id="@+id/presetContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingMultiplier="1.15"
            android:text="A 7,83 Hz-et a fül közvetlenül nem hallja, ezért binaurális lebegésként (fejhallgató kell) vagy izokronikus impulzusként (hangszóróval is megy) szól. A hardveres Schumann-generátorok elektromágneses jelet adnak, nem hangot. A frekvenciák egészségügyi hatása tudományosan nem igazolt."
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
